<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SmartTask Landing Page</title>

  <!-- Google Fonts -->
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@600&family=Open+Sans&display=swap" rel="stylesheet">

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Open Sans', sans-serif;
      background: #F9FAFB;
      color: #111827;
    }

    /* Navbar */
    .navbar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 20px;
      background: #FFFFFF;
    }

    .navbar h1 {
      font-family: 'Poppins', sans-serif;
    }

    /* Button */
    .btn {
      background: #4F46E5;
      color: white;
      padding: 10px 20px;
      text-decoration: none;
      border-radius: 6px;
      transition: 0.3s;
    }

    .btn:hover {
      background: #4338CA;
    }

    /* Hero Section */
    .hero {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 60px 20px;
      flex-wrap: wrap;
    }

    .hero-text {
      max-width: 500px;
    }

    .hero h2 {
      font-family: 'Poppins', sans-serif;
      font-size: 36px;
      margin-bottom: 10px;
    }

    .hero img {
      width: 300px;
      max-width: 100%;
    }

    /* Features Section */
    .features {
      padding: 60px 20px;
      text-align: center;
    }

    .feature-container {
      display: flex;
      gap: 20px;
      margin-top: 20px;
      flex-wrap: wrap;
    }

    .card {
      background: white;
      padding: 20px;
      flex: 1;
      border-radius: 8px;
      min-width: 200px;
      box-shadow: 0 4px 10px rgba(0,0,0,0.1);
    }

    /* About */
    .about {
      padding: 60px 20px;
      text-align: center;
    }

    /* Footer */
    footer {
      text-align: center;
      padding: 20px;
      background: #111827;
      color: white;
    }

    /* Responsive */
    @media (max-width: 768px) {
      .hero {
        flex-direction: column;
        text-align: center;
      }

      .feature-container {
        flex-direction: column;
      }
    }
  </style>

</head>

<body>

<header>
  <nav class="navbar">
    <h1>SmartTask</h1>
    <a href="#" class="btn">Get Started</a>
  </nav>
</header>

<main>

  <!-- Hero -->
  <section class="hero">
    <div class="hero-text">
      <h2>Organize Your Work Smarter</h2>
      <p>Boost productivity with our simple task manager.</p>
      <br>
      <a href="#" class="btn">Try Free</a>
    </div>
    <img src="https://via.placeholder.com/400" alt="Task Illustration">
  </section>

  <!-- Features -->
  <section class="features">
    <h2>Features</h2>

    <div class="feature-container">
      <div class="card">
        <h3>Easy Tracking</h3>
        <p>Track your tasks effortlessly.</p>
      </div>

      <div class="card">
        <h3>Collaboration</h3>
        <p>Work with your team in real time.</p>
      </div>

      <div class="card">
        <h3>Analytics</h3>
        <p>Get insights into your productivity.</p>
      </div>
    </div>
  </section>

  <!-- About -->
  <section class="about">
    <h2>Why Choose Us?</h2>
    <p>We focus on simplicity, speed, and user-friendly design.</p>
  </section>

</main>

<footer>
  <p>© 2026 SmartTask | All Rights Reserved</p>
</footer>

</body>
</html>
